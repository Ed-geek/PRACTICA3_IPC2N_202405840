@model MascotaFormViewModel
@{
    ViewData["Title"] = "Editar mascota";
}

<h1>Editar mascota <span style="color: var(--text-secondary); font-size: 1rem;">(@Model.Tipo)</span></h1>

<div class="form-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Tipo" />

        <div class="form-group">
            <label asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" class="form-control" required />
        </div>
        <div class="form-group">
            <label asp-for="Raza">Raza</label>
            <input asp-for="Raza" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Edad">Edad (años)</label>
            <input asp-for="Edad" type="number" min="0" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Peso">Peso (kg)</label>
            <input asp-for="Peso" type="number" step="0.01" min="0" class="form-control" required />
        </div>
        
        <div class="form-actions">
            <button type="submit" class="btn">Actualizar datos</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>