@model MascotaFormViewModel
@{
    ViewData["Title"] = "Editar mascota";
}

<h1>Editar mascota (@Model.Tipo)</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Tipo" />

    <div class="form-group">
        <label asp-for="Nombre">Nombre</label>
        <input asp-for="Nombre" required />
    </div>
    <div class="form-group">
        <label asp-for="Raza">Raza</label>
        <input asp-for="Raza" />
    </div>
    <div class="form-group">
        <label asp-for="Edad">Edad (años)</label>
        <input asp-for="Edad" type="number" min="0" />
    </div>
    <div class="form-group">
        <label asp-for="Peso">Peso (kg)</label>
        <input asp-for="Peso" type="number" step="0.01" min="0" required />
    </div>
    <button type="submit" class="btn">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>