@model List<Mascota>
@{
    ViewData["Title"] = "Mascotas";
}

<h1>Mascotas registradas</h1>

<p><a class="btn" asp-action="Create">+ Nueva mascota</a></p>

@if (Model.Count == 0)
{
    <p>No hay mascotas registradas todavía.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>ID</th><th>Tipo</th><th>Nombre</th><th>Raza</th>
                <th>Edad</th><th>Peso (kg)</th><th>Estado</th><th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Id</td>
                <td>@m.Tipo</td>
                <td>@m.Nombre</td>
                <td>@m.Raza</td>
                <td>@m.Edad</td>
                <td>@m.Peso</td>
                <td>@(m.Enferma ? "🤒 Enferma" : "✅ Sana")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@m.Id">Ver</a> ·
                    <a asp-action="Edit" asp-route-id="@m.Id">Editar</a> ·
                    <a asp-action="Delete" asp-route-id="@m.Id">Eliminar</a> ·
                    <form class="inline-form" asp-action="CambiarEstado" asp-route-id="@m.Id" method="post">
                        <button type="submit" class="btn btn-secondary">Cambiar estado</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}