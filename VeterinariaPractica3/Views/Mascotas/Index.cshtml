@model List<Mascota>
@{
    ViewData["Title"] = "Mascotas";
}

<div class="flex-between" style="margin-bottom: 1.5rem;">
    <h1>Mascotas registradas</h1>
    <a class="btn" asp-action="Create">+ Nueva mascota</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert">
        No hay mascotas registradas todavía. ¡Registra la primera!
    </div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tipo</th>
                    <th>Nombre</th>
                    <th>Edad</th>
                    <th>Peso</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td><span style="color: var(--text-secondary)">#@m.Id</span></td>
                    <td>@m.Tipo</td>
                    <td style="font-weight: 500;">@m.Nombre</td>
                    <td>@m.Edad años</td>
                    <td>@m.Peso kg</td>
                    <td>
                        <span class="badge @(m.Enferma ? "badge-enferma" : "badge-sana")">
                            @(m.Enferma ? "Enferma" : "Sana")
                        </span>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@m.Id">Ver</a>
                        <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@m.Id">Editar</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@m.Id">Borrar</a>
                        
                        <form class="inline-form" asp-action="CambiarEstado" asp-route-id="@m.Id" method="post">
                            <button type="submit" class="btn btn-sm" style="background-color: #805ad5;">Estado</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}