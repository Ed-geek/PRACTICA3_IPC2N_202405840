@model Mascota
@{
    ViewData["Title"] = "Detalle de mascota";
}

<h1>@Model.Nombre <small>(@Model.Tipo)</small></h1>

<table>
    <tr><th>ID</th><td>@Model.Id</td></tr>
    <tr><th>Tipo</th><td>@Model.Tipo</td></tr>
    <tr><th>Nombre</th><td>@Model.Nombre</td></tr>
    <tr><th>Raza</th><td>@Model.Raza</td></tr>
    <tr><th>Edad</th><td>@Model.Edad años</td></tr>
    <tr><th>Peso</th><td>@Model.Peso kg</td></tr>
    <tr><th>Estado</th><td>@(Model.Enferma ? "🤒 Enferma" : "✅ Sana")</td></tr>
</table>

<h2>Cálculo de dosis</h2>
<form asp-action="CalcularDosis" asp-route-id="@Model.Id" method="post">
    <div class="form-group">
        <label for="dosisPorKilogramo">Dosis por kilogramo (mg/kg)</label>
        <input id="dosisPorKilogramo" name="dosisPorKilogramo" type="number" step="0.01" min="0" required />
    </div>
    <button type="submit" class="btn">Calcular dosis</button>
</form>

@if (TempData["DosisCalculada"] is string dosisStr && double.TryParse(dosisStr, out double dosis))
{
    <div class="alert">
        <strong>Dosis total ajustada:</strong> @dosis.ToString("0.00") mg
        <br />
        <small>
            Cálculo: @Model.Peso kg × @TempData["DosisPorKg"] mg/kg ×
            factor @Model.Tipo = @dosis.ToString("0.00") mg
        </small>
    </div>
}

<p style="margin-top:1.5rem">
    <a asp-action="Index" class="btn btn-secondary">← Volver al listado</a>
</p>