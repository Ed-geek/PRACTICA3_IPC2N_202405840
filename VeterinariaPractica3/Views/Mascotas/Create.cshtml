@model MascotaFormViewModel
@{
    ViewData["Title"] = "Registrar mascota";
}

<h1>Registrar mascota</h1>

<div class="form-card">
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="Tipo">Tipo de mascota</label>
            <select asp-for="Tipo" class="form-control">
                <option value="Perro">Perro</option>
                <option value="Gato">Gato</option>
                <option value="Ave">Ave</option>
                <option value="Tortuga">Tortuga</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Firulais" required />
        </div>
        <div class="form-group">
            <label asp-for="Raza">Raza</label>
            <input asp-for="Raza" class="form-control" placeholder="Ej. Labrador" />
        </div>
        <div class="form-group">
            <label asp-for="Edad">Edad (años)</label>
            <input asp-for="Edad" type="number" min="0" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Peso">Peso (kg)</label>
            <input asp-for="Peso" type="number" step="0.01" min="0" class="form-control" required />
        </div>
        
        <div class="form-actions">
            <button type="submit" class="btn">Guardar Mascota</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>